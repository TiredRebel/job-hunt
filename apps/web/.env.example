# API base URL used by Server Components, route handlers, and the /api
# proxy route that browser fetches go through. Defaults to the local
# gateway when unset.
API_URL=http://localhost:4000/v1

# Optional override: point Client Components straight at the gateway
# instead of the same-origin /api proxy. Build-time inlined (NEXT_PUBLIC_*)
# and requires the gateway's WEB_ORIGIN to allow this app's origin — leave
# unset unless you have a reason.
# NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Whether the /api proxy forwards an incoming X-Forwarded-For header to the
# gateway. X-Forwarded-For is not a forbidden fetch() header, so a browser
# can set it directly — only enable this when a trusted reverse proxy sits
# in front of THIS web app and overwrites/strips any client-supplied value
# before it reaches this route. Mirrors the gateway's own
# TRUST_PROXY_HEADERS flag. Defaults to false (never forwarded).
TRUST_PROXY_HEADERS=false
