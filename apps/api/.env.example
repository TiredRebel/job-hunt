# API gateway environment (see src/config/api-config.schema.ts for validation).
# NestJS's ConfigModule reads .env from this directory (the process cwd when
# `npm run dev`/`npm start` runs inside apps/api) — copy this file to .env and
# fill in values matching the repo-root .env.

# HTTP port the gateway listens on.
API_PORT=4000

# Full Postgres connection URL (database `jobhunter`).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/jobhunter?sslmode=disable

# Base URLs for downstream services.
SCRAPER_BASE_URL=http://localhost:8001
LLM_BASE_URL=http://localhost:8002

# Shared secret for internal service calls (n8n, scraper/llm automation
# endpoints) — must be at least 16 characters.
INTERNAL_API_TOKEN=CHANGE_ME_long_random_string

# Log level (pino): trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# CORS allowlist (comma-separated origins) for browsers hitting the
# gateway directly. The normal path is same-origin via the web app's /api
# proxy route, where CORS never applies — this only matters when
# NEXT_PUBLIC_API_URL points the browser straight at the gateway, or for
# tools issuing browser-context requests from other origins.
WEB_ORIGIN=http://localhost:3000,http://localhost:3100

# Rate limit on public (non-internal-token) endpoints: RATE_LIMIT_LIMIT
# requests per RATE_LIMIT_TTL milliseconds, per client. The internal-token
# automation surface (/v1/automation/*) is exempt (@SkipThrottle()).
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=120

# Max attempts for safe/idempotent downstream calls to the scraper/LLM
# services (bounded exponential backoff on network errors, 5xx, 429).
DOWNSTREAM_RETRY_ATTEMPTS=3

# Whether the rate limiter trusts a client-supplied X-Forwarded-For header
# for its per-client key. X-Forwarded-For is spoofable by any direct caller,
# so only set this to true when a trusted reverse proxy sits in front and
# overwrites/strips the header before it reaches the gateway. Defaults to
# false (key by socket address).
TRUST_PROXY_HEADERS=false
