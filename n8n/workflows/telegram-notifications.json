{
  "id": "jh-telegram-notifications",
  "name": "job-hunter: telegram-notifications",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "b1a1b890-0021-4a1a-9c1a-000000000021",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-640, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.JOB_HUNTER_API_BASE_URL}}/automation/matches/unnotified?channel=telegram",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b1a1b890-0022-4a1a-9c1a-000000000022",
      "name": "Get Unnotified Matches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-400, 0],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Job Hunter Internal Token"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const matches = $input.first().json;\nreturn (matches || []).map((m) => {\n  const lines = [\n    `New match: ${m.jobTitle}${m.company ? ' at ' + m.company : ''}`,\n    `Score: ${m.score}/100`,\n  ];\n  if (m.explanation) lines.push(m.explanation);\n  lines.push(m.url);\n  return { json: { ...m, text: lines.join('\\n') } };\n});"
      },
      "id": "b1a1b890-0023-4a1a-9c1a-000000000023",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{$json.text}}",
        "additionalFields": {}
      },
      "id": "b1a1b890-0024-4a1a-9c1a-000000000024",
      "name": "Send Telegram Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [80, 0],
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": {
          "name": "Job Hunter Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.JOB_HUNTER_API_BASE_URL}}/automation/notifications",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobMatchId: $json.jobMatchId, channel: 'telegram' }) }}",
        "options": {}
      },
      "id": "b1a1b890-0025-4a1a-9c1a-000000000025",
      "name": "Record Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [320, 0],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "name": "Job Hunter Internal Token"
        }
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "Get Unnotified Matches", "type": "main", "index": 0 }]]
    },
    "Get Unnotified Matches": {
      "main": [[{ "node": "Build Message", "type": "main", "index": 0 }]]
    },
    "Build Message": {
      "main": [[{ "node": "Send Telegram Message", "type": "main", "index": 0 }]]
    },
    "Send Telegram Message": {
      "main": [[{ "node": "Record Notification", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
