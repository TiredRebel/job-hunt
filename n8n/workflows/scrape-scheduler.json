{
  "id": "jh-scrape-scheduler",
  "name": "job-hunter: scrape-scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "b1a1b890-0001-4a1a-9c1a-000000000001",
      "name": "Hourly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.JOB_HUNTER_API_BASE_URL}}/sources",
        "options": {}
      },
      "id": "b1a1b890-0002-4a1a-9c1a-000000000002",
      "name": "Get Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Enabled sources only, and only the ones due this tick.\n// Cadence hint lives in source.config.cron (seeded by infra/db/seed.sql):\n// 4-hourly sources (reddit, upwork) run only when the current UTC hour is\n// a multiple of 4; everything else (hourly hint or no hint) runs every tick.\n// Deliberately simple (no cron parser dependency) -- see n8n/README.md.\nconst sources = $input.first().json;\nconst hour = new Date().getUTCHours();\nconst due = [];\nfor (const source of sources) {\n  if (!source.enabled) continue;\n  const cron = source.config && source.config.cron;\n  const isFourHourly = typeof cron === 'string' && cron.includes('*/4');\n  if (isFourHourly && hour % 4 !== 0) continue;\n  due.push({ json: source });\n}\nreturn due;"
      },
      "id": "b1a1b890-0003-4a1a-9c1a-000000000003",
      "name": "Filter Enabled + Due",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.JOB_HUNTER_API_BASE_URL}}/sources/{{$json.slug}}/scrape",
        "options": {}
      },
      "id": "b1a1b890-0004-4a1a-9c1a-000000000004",
      "name": "Trigger Scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [320, 0],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Hourly Trigger": {
      "main": [[{ "node": "Get Sources", "type": "main", "index": 0 }]]
    },
    "Get Sources": {
      "main": [[{ "node": "Filter Enabled + Due", "type": "main", "index": 0 }]]
    },
    "Filter Enabled + Due": {
      "main": [[{ "node": "Trigger Scrape", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
