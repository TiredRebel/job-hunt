{
  "id": "jh-email-digest",
  "name": "job-hunter: email-digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "b1a1b890-0031-4a1a-9c1a-000000000031",
      "name": "Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-640, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.JOB_HUNTER_API_BASE_URL}}/automation/digest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b1a1b890-0032-4a1a-9c1a-000000000032",
      "name": "Get Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-400, 0],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Job Hunter Internal Token"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const digest = $input.first().json;\nconst jobs = digest.newJobs || [];\nconst matches = digest.newMatches || [];\nconst subject = `Job Hunter digest: ${jobs.length} new job${jobs.length === 1 ? '' : 's'}, ${matches.length} new match${matches.length === 1 ? '' : 'es'}`;\n\nconst matchRows = matches\n  .map((m) => `<li><a href=\"${m.url}\">${m.title}</a> — score ${m.score}/100</li>`)\n  .join('');\nconst jobRows = jobs\n  .map((j) => `<li>${j.title} (${j.sourceSlug})</li>`)\n  .join('');\n\nconst html = `<h2>Top matches</h2><ul>${matchRows || '<li>No new matches.</li>'}</ul><h2>New jobs</h2><ul>${jobRows || '<li>No new jobs.</li>'}</ul>`;\n\nreturn [{ json: { subject, html } }];"
      },
      "id": "b1a1b890-0033-4a1a-9c1a-000000000033",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "={{$env.SMTP_USER}}",
        "toEmail": "={{$env.DIGEST_TO_EMAIL}}",
        "subject": "={{$json.subject}}",
        "emailFormat": "html",
        "html": "={{$json.html}}",
        "options": {}
      },
      "id": "b1a1b890-0034-4a1a-9c1a-000000000034",
      "name": "Send Digest Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [80, 0],
      "credentials": {
        "smtp": {
          "name": "Job Hunter SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.JOB_HUNTER_API_BASE_URL}}/automation/digest/sent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b1a1b890-0035-4a1a-9c1a-000000000035",
      "name": "Mark Digest Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [320, 0],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Job Hunter Internal Token"
        }
      }
    }
  ],
  "connections": {
    "Daily 08:00": {
      "main": [[{ "node": "Get Digest", "type": "main", "index": 0 }]]
    },
    "Get Digest": {
      "main": [[{ "node": "Build Email", "type": "main", "index": 0 }]]
    },
    "Build Email": {
      "main": [[{ "node": "Send Digest Email", "type": "main", "index": 0 }]]
    },
    "Send Digest Email": {
      "main": [[{ "node": "Mark Digest Sent", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
