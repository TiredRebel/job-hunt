# ── Database (existing pg-learn container, Postgres 17) ─────────────
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/jobhunter?sslmode=disable

# dbmate (npm run db:*) — migrations live under infra/, not dbmate's default ./db
DBMATE_MIGRATIONS_DIR=./infra/db/migrations
DBMATE_SCHEMA_FILE=./infra/db/schema.sql

# ── Redis (queue / pub-sub, from infra/docker-compose.yml) ──────────
REDIS_URL=redis://localhost:6379/0

# ── Services ─────────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
SCRAPER_PORT=8001
LLM_PORT=8002
API_BASE_URL=http://localhost:4000
SCRAPER_BASE_URL=http://localhost:8001
LLM_BASE_URL=http://localhost:8002

# CORS fallback for browsers hitting the gateway directly (the normal path
# is same-origin via the web app's /api proxy, where CORS never applies).
# Comma-separated list of allowed browser origins.
WEB_ORIGIN=http://localhost:3000,http://localhost:3100

# Shared secret for service-to-service and n8n→service calls
INTERNAL_API_TOKEN=CHANGE_ME_long_random_string

# ── n8n (existing container at :5678) ────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_NEW_MATCHES=http://localhost:5678/webhook/new-matches

# ── LLM providers (DB rows reference these names — see docs/LLM_CONFIG.md)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLOUD_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Sources ──────────────────────────────────────────────────────────
# Reddit official API (optional; unauthenticated JSON works at low volume)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=job-hunter/0.1 (personal job monitor)

# ── Notifications (used by n8n credentials, kept here for reference) ─
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO_EMAIL=

# ── Scraping politeness ──────────────────────────────────────────────
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_MAX_CONCURRENCY_PER_DOMAIN=1

# ── Observability (structured JSON logs; correlation id via X-Correlation-Id)
SCRAPER_LOG_LEVEL=info
LLM_LOG_LEVEL=info

# ── LLM provider request resilience ──────────────────────────────────
# Max attempts for provider adapter HTTP calls (network errors, 5xx, 429).
LLM_PROVIDER_RETRY_ATTEMPTS=3

# Gateway rate limiting + downstream retries — see apps/api/.env.example
# for RATE_LIMIT_TTL / RATE_LIMIT_LIMIT / DOWNSTREAM_RETRY_ATTEMPTS /
# TRUST_PROXY_HEADERS.
