# Docker Compose reads its own .env from this directory (infra/) for
# `${...}` substitution in docker-compose.yml — this is separate from the
# repo-root .env used by native processes/dbmate. Copy to infra/.env and
# fill in the real Postgres role/password (must match the repo-root .env's
# DATABASE_URL credentials, since both point at the same database).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# n8n owns a separate Postgres database. These values must match the
# credentials already stored in n8n_db_storage when migrating an existing
# installation; fresh installations initialize the named volume with them.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME
N8N_VERSION=stable
GENERIC_TIMEZONE=Europe/Kyiv
TZ=Europe/Kyiv
JOB_HUNTER_API_BASE_URL=http://host.docker.internal:4000/v1
JOB_HUNTER_LLM_BASE_URL=http://host.docker.internal:8002
SMTP_USER=
