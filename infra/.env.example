# Docker Compose reads its own .env from this directory (infra/) for
# `${...}` substitution in docker-compose.yml — this is separate from the
# repo-root .env used by native processes/dbmate. Copy to infra/.env and
# fill in the real Postgres role/password (must match the repo-root .env's
# DATABASE_URL credentials, since both point at the same database).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
